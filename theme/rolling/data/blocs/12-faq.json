":"h3"},"title":{"$$type":"escaped-html","value":"«&nbsp;Illimité&nbsp;», vraiment&nbsp;?"}},"elements":[],"widgetType":"e-heading","editor_settings":{"title":"Question 1 · titre"},"version":"0.0"},{"id":"5e33c813","elType":"widget","settings":{"classes":{"$$type":"classes","value":["g-1a3f1cd"]},"paragraph":{"$$type":"escaped-html","value":"Oui&nbsp;: nous ne comptons pas les vidéos. Nous traitons un projet à fond à la fois, puis nous enchaînons sur le suivant. C'est ce qui rend l'illimité possible, avec une qualité garantie sur chaque vidéo."}},"elements":[],"widgetType":"e-paragraph","editor_settings":{"title":"Question 1 · réponse"},"version":"0.0"}],"isInner":false,"editor_settings":{"title":"Question 1"},"version":"0.0"},{"id":"52bacef2","elType":"e-flexbox","settings":{"classes":{"$$type":"classes","value":["g-d9b9258","g-f3c7ac1"]}},"elements":[{"id":"3c2da299","elType":"widget","settings":{"classes":{"$$type":"classes","value":["g-8780a1c"]},"tag":{"$$type":"string","value":"h3"},"title":{"$$type":"escaped-html","value":"La captation, vraiment offerte&nbsp;?"}},"elements":[],"widgetType":"e-heading","editor_settings":{"title":"Question 2 · titre"},"version":"0.0"},{"id":"716312af","elType":"widget","settings":{"classes":{"$$type":"classes","value":["g-1a3f1cd"]},"paragraph":{"$$type":"escaped-html","value":"Oui, avec la formule Création&nbsp;+&nbsp;Tournage. Nos équipes se déplacent partout en France pour filmer vos collaborateurs, vos événements et vos produits, un projet à la fois."}},"elements":[],"widgetType":"e-paragraph","editor_settings":{"title":"Question 2 · réponse"},"version":"0.0"}],"isInner":false,"editor_settings":{"title":"Question 2"},"version":"0.0"},{"id":"2501fa7e","elType":"e-flexbox","settings":{"classes":{"$$type":"classes","value":["g-d9b9258","g-f3c7ac1"]}},"elements":[{"id":"52a4500c","elType":"widget","settings":{"classes":{"$$type":"classes","value":["g-8780a1c"]},"tag":{"$$type":"string","value":"h3"},"title":{"$$type":"escaped-h